# ======================================================================
# Файл конфігурації Apache (.htaccess)
# Проект: eurolam.com.ua
# ======================================================================

<IfModule mod_rewrite.c>
    # Вмикаємо модуль обробки URL-адрес
    RewriteEngine On

    # Виключення: НЕ перенаправляти запити перевірки SSL (Let's Encrypt)
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/

    # ------------------------------------------------------------------
    # 1. Редирект з WWW на NON-WWW (www.eurolam.com.ua -> eurolam.com.ua)
    # ------------------------------------------------------------------
    # Перевіряємо, чи починається хост з www.
    RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
    # Перенаправляємо на HTTPS-версію без www з збереженням точної сторінки
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # ------------------------------------------------------------------
    # 2. Перенаправлення з HTTP на HTTPS (для запитів без www)
    # ------------------------------------------------------------------
    # Перевіряємо, чи з'єднання незахищене (HTTP)
    RewriteCond %{HTTPS} off
    # Перенаправляємо на HTTPS-версію
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ----------------------------------------------------------------------
# 3. Фіксація кодування UTF-8 (для запобігання "кракозябрам")
# ----------------------------------------------------------------------
# Установлюємо UTF-8 як кодування за замовчуванням
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
    AddCharset UTF-8 .html .css .js .xml .json
</IfModule>